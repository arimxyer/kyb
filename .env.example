# Created by `npx convex dev` after the project is linked.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# For non-interactive / sandboxed agents that must push (`npx convex deploy`).
# Mint from the dashboard or `npx convex deployment token create <name> --prod`.
# Set as an env var in the agent's environment; never commit a real value.
CONVEX_DEPLOY_KEY=
